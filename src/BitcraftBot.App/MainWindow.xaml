<Window x:Class="BitcraftBot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BitCraft Bot"
        Icon="Assets/bitcraftbot.ico"
        Width="960" Height="540" MinWidth="640" MinHeight="400"
        Background="#1E1F22" Foreground="#E6E6E6"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6E6E6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="HudLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="Margin" Value="0,1,8,1" />
        </Style>
        <Style x:Key="HudValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#26282C" />
            <Setter Property="BorderBrush" Value="#3C3F44" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
    </Window.Resources>

    <TabControl x:Name="Tabs" Background="#1E1F22" BorderBrush="#3C3F44" Margin="4">

        <!-- ONGLET 1 : SUPERVISION -->
        <TabItem Header="Supervision">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- Image du jeu en direct, avec les zones lues en surimpression -->
                <Border Grid.Row="0" Grid.Column="0" Background="Black" BorderBrush="#3C3F44" BorderThickness="1">
                    <Grid>
                        <Viewbox Stretch="Uniform">
                            <Grid x:Name="FrameHost">
                                <Image x:Name="GameImage" Stretch="Fill" RenderOptions.BitmapScalingMode="LowQuality" />
                                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="NoImageText" Text="Pas d'image. Cliquez sur « Démarrer »."
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9AA0A6" />
                    </Grid>
                </Border>

                <!-- Panneau d'état et de commande -->
                <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                    <StackPanel>
                        <Border x:Name="StatusBorder" Background="#3C3F44" CornerRadius="4" Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="StatusText" Text="ARRÊTÉ" FontSize="18" FontWeight="Bold" />
                                <TextBlock x:Name="StatusDetail" Text="Aucune session en cours." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="StartButton" Content="Démarrer" Click="StartButton_Click" />
                            <Button x:Name="StopButton" Content="Arrêter" Click="StopButton_Click" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock Text="Arrêt d'urgence : touche Num 5 (même quand le jeu est au premier plan)."
                                   TextWrapping="Wrap" Foreground="#F28B82" Margin="0,6,0,0" />

                        <TextBlock Text="LECTURE DU HUD" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Position" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HudPosition" Text="—" Style="{StaticResource HudValue}" />
                            <TextBlock Grid.Row="1" Text="Zone" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HudZone" Text="—" Style="{StaticResource HudValue}" />
                            <TextBlock Grid.Row="2" Text="Vie" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HudHealth" Text="—" Style="{StaticResource HudValue}" />
                            <TextBlock Grid.Row="3" Text="Endurance" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="HudStamina" Text="—" Style="{StaticResource HudValue}" />
                            <TextBlock Grid.Row="4" Text="Faim" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="HudHunger" Text="—" Style="{StaticResource HudValue}" />
                            <TextBlock Grid.Row="5" Text="Cible" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="HudTarget" Text="—" Style="{StaticResource HudValue}" />
                            <TextBlock Grid.Row="6" Text="Santé cible" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="HudTargetHealth" Text="—" Style="{StaticResource HudValue}" />
                            <TextBlock Grid.Row="7" Text="Lecture" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="HudReadTime" Text="—" Style="{StaticResource HudValue}" />
                        </Grid>
                        <CheckBox x:Name="ShowZonesCheck" Content="Afficher les zones lues sur l'image" IsChecked="True"
                                  Click="ShowZonesCheck_Click" />

                        <TextBlock Text="SESSION" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="ElapsedText" Text="Durée : 00:00" />
                        <TextBlock x:Name="RemainingText" Text="Restant : —" />
                        <TextBlock x:Name="FpsText" Text="Images par seconde : —" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Images/s visées :" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TargetFpsBox" Text="5" Width="40" LostFocus="TargetFpsBox_LostFocus" />
                        </StackPanel>

                        <TextBlock Text="JEU" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="GameWindowText" Text="Fenêtre du jeu : non cherchée" TextWrapping="Wrap" />

                        <TextBlock Text="SÉCURITÉ" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="EmergencyKeyCheck" Content="Touche d'arrêt d'urgence (Num 5)" IsChecked="True"
                                  Click="SafetyCheck_Click" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="MaxDurationCheck" Content="Durée max (min) :" IsChecked="True"
                                      Click="SafetyCheck_Click" VerticalAlignment="Center" />
                            <TextBox x:Name="MaxDurationBox" Text="15" Width="40" Margin="6,0,0,0"
                                     LostFocus="MaxDurationBox_LostFocus" />
                        </StackPanel>
                        <CheckBox x:Name="AnomalyCheck" Content="Arrêt sur anomalie (RAM du bot critique)" IsChecked="True"
                                  Click="SafetyCheck_Click" />
                        <CheckBox Content="Arrêt si la souris bouge (à partir de v0.4)" IsEnabled="False" />

                        <TextBlock x:Name="VersionText" Text="Version" Foreground="#9AA0A6" Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Dernier événement du journal (le journal complet est dans l'onglet Journal) -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#141517" BorderBrush="#3C3F44" BorderThickness="1"
                        Margin="0,6,0,0" Padding="8,4">
                    <DockPanel>
                        <TextBlock x:Name="AlertCounters" DockPanel.Dock="Right" Foreground="#9AA0A6" Margin="12,0,0,0" />
                        <TextBlock x:Name="LastEventText" Text="—" FontFamily="Consolas" FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- ONGLET 2 : JOURNAL -->
        <TabItem Header="Journal">
            <DockPanel Margin="6">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Afficher :" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox x:Name="FilterErreur" Content="Erreurs" IsChecked="True" Margin="0,0,12,0" Click="LogFilter_Click" Foreground="#F28B82" />
                    <CheckBox x:Name="FilterAlerte" Content="Alertes" IsChecked="True" Margin="0,0,12,0" Click="LogFilter_Click" Foreground="#FDD663" />
                    <CheckBox x:Name="FilterInfo" Content="Infos" IsChecked="True" Margin="0,0,12,0" Click="LogFilter_Click" />
                    <CheckBox x:Name="FilterDetail" Content="Détails" IsChecked="False" Margin="0,0,20,0" Click="LogFilter_Click" Foreground="#9AA0A6" />
                    <Button Content="Ouvrir le dossier des journaux" Click="OpenLogFolder_Click" />
                    <TextBlock x:Name="LogFileText" VerticalAlignment="Center" Foreground="#9AA0A6" Margin="8,0,0,0" />
                </StackPanel>
                <ListBox x:Name="LogList" Background="#141517" BorderBrush="#3C3F44" FontFamily="Consolas" FontSize="12"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>

        <!-- ONGLET : SERVEUR (voie hybride, livrable H1, D-039) -->
        <TabItem Header="Serveur (H1)">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#9AA0A6" Margin="0,0,0,10" MaxWidth="1100" HorizontalAlignment="Left"
                               Text="Lecture en direct du serveur officiel, en lecture seule, avec le jeton de votre compte. Le bot ne fait que lire : aucune action n'est envoyée au serveur. Le jeton est chiffré par Windows sur ce PC, et n'apparaît jamais dans le journal." />
                    <WrapPanel>
                        <!-- 1. Compte -->
                        <Border Style="{StaticResource Card}" Width="360">
                            <StackPanel>
                                <TextBlock Text="1. COMPTE BITCRAFT" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <TextBlock Text="Adresse e-mail liée au compte BitCraft :" />
                                <TextBox x:Name="ServerEmailBox" Margin="0,2,0,6" />
                                <Button x:Name="RequestCodeButton" Content="Recevoir le code par e-mail" HorizontalAlignment="Left"
                                        Click="RequestCodeButton_Click" />
                                <TextBlock Text="Code reçu :" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBox x:Name="ServerCodeBox" Width="140" Margin="0,0,6,0" />
                                    <Button x:Name="ValidateCodeButton" Content="Valider le code" Click="ValidateCodeButton_Click" />
                                </StackPanel>
                                <TextBlock x:Name="TokenStatusText" Text="Aucun jeton enregistré." Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <Button x:Name="ForgetTokenButton" Content="Oublier le jeton" HorizontalAlignment="Left" Margin="0,6,0,0"
                                        Click="ForgetTokenButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- 2. Connexion -->
                        <Border Style="{StaticResource Card}" Width="360">
                            <StackPanel>
                                <TextBlock Text="2. CONNEXION (LECTURE SEULE)" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Région : R" VerticalAlignment="Center" />
                                    <TextBox x:Name="ServerRegionBox" Text="18" Width="40" Margin="2,0,0,0" />
                                </StackPanel>
                                <Border Background="#3A2E12" CornerRadius="4" Padding="8" Margin="0,8,0,8">
                                    <TextBlock TextWrapping="Wrap" Foreground="#FDD663"
                                               Text="Ordre à respecter : 1) jeu fermé, 2) connecter le bot ici, 3) lancer le jeu. Si le jeu est déjà lancé, le bot devient la connexion « principale » du compte : sa fermeture peut déconnecter votre personnage." />
                                </Border>
                                <TextBlock x:Name="ServerGameRunningText" Text="Jeu : —" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="ServerConnectButton" Content="Se connecter" Click="ServerConnectButton_Click" />
                                    <Button x:Name="ServerDisconnectButton" Content="Se déconnecter" IsEnabled="False" Click="ServerDisconnectButton_Click" />
                                </StackPanel>
                                <TextBlock x:Name="ServerStateText" Text="Pas connecté." Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock x:Name="ServerTrafficText" Text="" Foreground="#9AA0A6" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 3. En direct -->
                        <Border Style="{StaticResource Card}" Width="360">
                            <StackPanel>
                                <TextBlock Text="3. PERSONNAGE EN DIRECT" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Personnage" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SrvCharacter" Text="—" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="1" Text="Région" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SrvRegion" Text="—" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="2" Text="Position serveur" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SrvPosition" Text="—" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="3" Text="Destination" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SrvDestination" Text="—" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="4" Text="Position écran" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SrvHudPosition" Text="— (lancer « Démarrer » dans Supervision)" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="5" Text="Vie" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SrvHealth" Text="—" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="6" Text="Endurance" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="SrvStamina" Text="—" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="7" Text="Faim (satiété)" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="SrvSatiation" Text="—" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="8" Text="Mise à jour" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" x:Name="SrvUpdated" Text="—" Style="{StaticResource HudValue}" />
                                </Grid>
                                <Button x:Name="ServerSnapshotButton" Content="Enregistrer un instantané (diagnostic)" HorizontalAlignment="Left"
                                        Margin="0,8,0,0" IsEnabled="False" Click="ServerSnapshotButton_Click" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- 4. Ressources proches -->
                    <Border Style="{StaticResource Card}" MaxWidth="1100" HorizontalAlignment="Left">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="4. RESSOURCES PROCHES" Style="{StaticResource SectionTitle}" Margin="0,0,16,0" />
                                <CheckBox x:Name="TreesOnlyCheck" Content="Arbres seulement" IsChecked="True" VerticalAlignment="Center" />
                                <TextBlock x:Name="SrvResourceCount" Text="" Foreground="#9AA0A6" VerticalAlignment="Center" Margin="16,0,0,0" />
                            </StackPanel>
                            <ListView x:Name="SrvResourceList" Height="260" Background="#141517" Foreground="#E6E6E6" BorderBrush="#3C3F44">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Nom" Width="260" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Catégorie" Width="130" DisplayMemberBinding="{Binding Tag}" />
                                        <GridViewColumn Header="Palier" Width="60" DisplayMemberBinding="{Binding Tier}" />
                                        <GridViewColumn Header="Distance (cases)" Width="110" DisplayMemberBinding="{Binding Distance}" />
                                        <GridViewColumn Header="Position serveur" Width="170" DisplayMemberBinding="{Binding Position}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ONGLET : TESTS DES MOUVEMENTS (D-035) -->
        <TabItem Header="Tests">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock TextWrapping="Wrap" Foreground="#9AA0A6" Margin="0,0,0,10"
                               Text="Banc d'essai des mouvements « humains » (souris et caméra). Fonction de test, désactivée à chaque démarrage. Mettez-vous dans un endroit calme, sans ennemis. Au lancement, le jeu passe au premier plan après 3 secondes." />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="TestsEnabledCheck" Content="Activer le banc d'essai" FontWeight="SemiBold"
                                      Click="TestsEnabledCheck_Click" />
                            <TextBlock TextWrapping="Wrap" Foreground="#F28B82" Margin="0,4,0,0"
                                       Text="Arrêt immédiat : touche Num 5, ou bougez vous-même la souris, ou cliquez hors du jeu." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Durée d'un test (secondes) :" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="TestDurationBox" Text="30" Width="45" />
                            </StackPanel>
                            <TextBlock Text="SOURIS" Style="{StaticResource SectionTitle}" />
                            <TextBlock TextWrapping="Wrap" Foreground="#9AA0A6"
                                       Text="Trajets en courbe, vitesse qui accélère puis ralentit, petit dépassement de la cible, pauses variables. La souris reste au centre de l'écran (hors HUD, minicarte, chat, barre d'action)." />
                            <CheckBox x:Name="AllowClicksCheck" Content="Étape 2 : autoriser les clics gauche (le personnage se déplace un peu)"
                                      Margin="0,6,0,6" />
                            <Button x:Name="TestMouseButton" Content="Lancer le test souris" HorizontalAlignment="Left"
                                    IsEnabled="False" Click="TestMouseButton_Click" />
                            <TextBlock Text="CAMÉRA" Style="{StaticResource SectionTitle}" />
                            <TextBlock TextWrapping="Wrap" Foreground="#9AA0A6"
                                       Text="Rotations avec Z / Q / S / D, appuis et pauses de durée variable, W de temps en temps pour recentrer. Aucune autre touche." />
                            <Button x:Name="TestCameraButton" Content="Lancer le test caméra" HorizontalAlignment="Left"
                                    IsEnabled="False" Click="TestCameraButton_Click" Margin="0,6,0,0" />
                            <Button x:Name="TestStopButton" Content="Arrêter le test" HorizontalAlignment="Left"
                                    IsEnabled="False" Click="TestStopButton_Click" Margin="0,12,0,0" />
                            <TextBlock x:Name="TestStatusText" Text="Banc d'essai désactivé." Margin="0,10,0,0"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock TextWrapping="Wrap" Foreground="#9AA0A6"
                               Text="Chaque geste est noté dans l'onglet Journal (cochez « Détails » pour tout voir)." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ONGLET : SYSTÈME -->
        <TabItem Header="Système">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#9AA0A6" Margin="0,0,0,10"
                               Text="Consommation mesurée chaque seconde. Le bot ne fait que lire ces valeurs : il ne modifie ni le jeu ni Windows. Si sa RAM dépasse le seuil critique, la session s'arrête toute seule." />
                    <WrapPanel>
                        <Border Style="{StaticResource Card}" Width="320">
                            <StackPanel>
                                <TextBlock Text="LE BOT" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <TextBlock x:Name="BotCpuText" Text="CPU : —" />
                                <Canvas x:Name="BotCpuGraph" Height="50" Margin="0,4" Background="#1A1C1F" ClipToBounds="True" />
                                <TextBlock x:Name="BotRamText" Text="RAM : —" />
                                <Canvas x:Name="BotRamGraph" Height="50" Margin="0,4" Background="#1A1C1F" ClipToBounds="True" />
                                <TextBlock x:Name="BotDetailsText" Text="—" Foreground="#9AA0A6" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="320">
                            <StackPanel>
                                <TextBlock Text="LE JEU (BitCraft)" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <TextBlock x:Name="GameCpuText" Text="CPU : —" />
                                <TextBlock x:Name="GameRamText" Text="RAM : —" />
                                <TextBlock Text="LE PC" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="SystemCpuText" Text="CPU : —" />
                                <TextBlock x:Name="SystemRamText" Text="RAM libre : —" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="320">
                            <StackPanel>
                                <TextBlock Text="SEUILS" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="RAM du bot : alerte (Mo)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="RamWarningBox" Margin="0,2" LostFocus="LimitBox_LostFocus" />
                                    <TextBlock Grid.Row="1" Text="RAM du bot : arrêt (Mo)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="RamCriticalBox" Margin="0,2" LostFocus="LimitBox_LostFocus" />
                                    <TextBlock Grid.Row="2" Text="CPU du bot : alerte (%)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="CpuWarningBox" Margin="0,2" LostFocus="LimitBox_LostFocus" />
                                    <TextBlock Grid.Row="3" Text="RAM libre du PC : alerte (%)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="SystemRamWarningBox" Margin="0,2" LostFocus="LimitBox_LostFocus" />
                                </Grid>
                                <TextBlock x:Name="ResourceStateText" Text="État : normal" Margin="0,8,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
