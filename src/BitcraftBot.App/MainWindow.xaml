<Window x:Class="BitcraftBot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BitcraftBot.App"
        Title="BitCraft Bot"
        Icon="Assets/bitcraftbot.ico"
        Width="960" Height="540" MinWidth="640" MinHeight="400"
        Background="#1E1F22" Foreground="#E6E6E6"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6E6E6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="HudLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="Margin" Value="0,1,8,1" />
        </Style>
        <Style x:Key="HudValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#26282C" />
            <Setter Property="BorderBrush" Value="#3C3F44" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
    </Window.Resources>

    <TabControl x:Name="Tabs" Background="#1E1F22" BorderBrush="#3C3F44" Margin="4">

        <!-- Onglets regroupés par usage (v0.3.16, demande de Julien) :
             Bot (piloter) · Personnage (état, bonus, sac) · Carte · Recettes · Paramètres (connexion, affichage, système, journal). -->

        <!-- ONGLET : BOT (démarrer, voir l'écran lu, sécurité, repas automatique) -->
        <TabItem Header="Bot">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- Tableau de bord (v0.3.17, D-043) en haut ; image du jeu en vignette en bas -->
                <Grid Grid.Row="0" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="240" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="Dashboard">
                            <!-- Personnage -->
                            <Border Style="{StaticResource Card}" Width="380">
                                <StackPanel>
                                    <TextBlock Text="PERSONNAGE" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="DashHealthText" Text="Vie : —" />
                                    <ProgressBar x:Name="DashHealthBar" Maximum="1" Height="10" Margin="0,2,0,6" Foreground="#34A853" Background="#141517" BorderThickness="0" />
                                    <TextBlock x:Name="DashStaminaText" Text="Endurance : —" />
                                    <ProgressBar x:Name="DashStaminaBar" Maximum="1" Height="10" Margin="0,2,0,6" Foreground="#FBBC04" Background="#141517" BorderThickness="0" />
                                    <TextBlock x:Name="DashHungerText" Text="Faim : —" />
                                    <ProgressBar x:Name="DashHungerBar" Maximum="1" Height="10" Margin="0,2,0,6" Foreground="#E8EAED" Background="#141517" BorderThickness="0" />
                                    <TextBlock x:Name="DashBonusText" Text="Bonus : —" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DashMiscText" Text="" Foreground="#9AA0A6" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <!-- Activité (serveur) -->
                            <Border Style="{StaticResource Card}" Width="380">
                                <StackPanel>
                                    <TextBlock Text="ACTIVITÉ" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="DashActionText" Text="Action : —" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="DashActionBar" Maximum="1" Height="10" Margin="0,2,0,6" Foreground="#8AB4F8" Background="#141517" BorderThickness="0" />
                                    <TextBlock x:Name="DashSkillText" Text="Métier : —" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="DashSkillBar" Maximum="1" Height="10" Margin="0,2,0,6" Foreground="#3DF58A" Background="#141517" BorderThickness="0" />
                                    <TextBlock x:Name="DashHitText" Text="Ressource frappée : —" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DashSkillsText" Text="" Foreground="#9AA0A6" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <!-- Sac et alentours -->
                            <Border Style="{StaticResource Card}" Width="380">
                                <StackPanel>
                                    <TextBlock Text="SAC ET ALENTOURS" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="DashSacText" Text="Sac : —" />
                                    <ProgressBar x:Name="DashSacBar" Maximum="1" Height="10" Margin="0,2,0,6" Foreground="#C58AF9" Background="#141517" BorderThickness="0" />
                                    <TextBlock x:Name="DashPositionText" Text="Position : —" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DashBestTreeText" Text="Meilleur arbre : —" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock x:Name="DashTreesText" Text="" Foreground="#9AA0A6" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <!-- Le bot -->
                            <Border Style="{StaticResource Card}" Width="380">
                                <StackPanel>
                                    <TextBlock Text="LE BOT" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="DashServerText" Text="Serveur : pas connecté" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DashScreenText" Text="Lecture de l’écran : arrêtée" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DashMealText" Text="Repas auto : désactivé" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DashAlertText" Text="" Foreground="#FDD663" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </ScrollViewer>

                    <!-- Image du jeu en direct, avec les zones lues en surimpression -->
                    <Border Grid.Row="1" Background="Black" BorderBrush="#3C3F44" BorderThickness="1" Margin="0,6,10,0">
                        <Grid>
                            <Viewbox Stretch="Uniform">
                                <Grid x:Name="FrameHost">
                                    <Image x:Name="GameImage" Stretch="Fill" RenderOptions.BitmapScalingMode="LowQuality" />
                                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="NoImageText" Text="Image du jeu : cliquez sur « Démarrer » (lecture de l’écran)."
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9AA0A6" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Panneau d'état et de commande -->
                <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                    <StackPanel>
                        <Border x:Name="StatusBorder" Background="#3C3F44" CornerRadius="4" Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="StatusText" Text="ARRÊTÉ" FontSize="18" FontWeight="Bold" />
                                <TextBlock x:Name="StatusDetail" Text="Aucune session en cours." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="StartButton" Content="Démarrer" Click="StartButton_Click" />
                            <Button x:Name="StopButton" Content="Arrêter" Click="StopButton_Click" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock Text="Arrêt d'urgence : touche Num 5, seulement quand BitCraft est la fenêtre active (D-041)."
                                   TextWrapping="Wrap" Foreground="#F28B82" Margin="0,6,0,0" />

                        <TextBlock Text="REPAS AUTOMATIQUE" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="AutoEatCheck" Content="Manger automatiquement (Maj + E)" Click="AutoEatCheck_Click" />
                        <TextBlock TextWrapping="Wrap" Foreground="#9AA0A6" Margin="0,2,0,0"
                                   Text="Faim sous 30 % ou plus de bonus de nourriture : le bot mange le premier aliment du sac, un à la fois, sans dépasser le manque. Seulement si BitCraft est actif et que vous ne tapez pas. Num 5 le coupe (D-042)." />
                        <TextBlock x:Name="AutoEatStatusText" Text="Désactivé." Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock x:Name="AutoEatFoodText" Text="" Foreground="#9AA0A6" TextWrapping="Wrap" />

                        <TextBlock Text="LECTURE DE L’ÉCRAN (HUD)" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Position" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HudPosition" Text="—" Style="{StaticResource HudValue}" />
                            <TextBlock Grid.Row="1" Text="Zone" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HudZone" Text="—" Style="{StaticResource HudValue}" />
                            <TextBlock Grid.Row="2" Text="Vie" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HudHealth" Text="—" Style="{StaticResource HudValue}" />
                            <TextBlock Grid.Row="3" Text="Endurance" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="HudStamina" Text="—" Style="{StaticResource HudValue}" />
                            <TextBlock Grid.Row="4" Text="Faim" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="HudHunger" Text="—" Style="{StaticResource HudValue}" />
                            <TextBlock Grid.Row="5" Text="Cible" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="HudTarget" Text="—" Style="{StaticResource HudValue}" />
                            <TextBlock Grid.Row="6" Text="Santé cible" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="HudTargetHealth" Text="—" Style="{StaticResource HudValue}" />
                            <TextBlock Grid.Row="7" Text="Lecture" Style="{StaticResource HudLabel}" />
                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="HudReadTime" Text="—" Style="{StaticResource HudValue}" />
                        </Grid>
                        <CheckBox x:Name="ShowZonesCheck" Content="Afficher les zones lues sur l'image" IsChecked="True"
                                  Click="ShowZonesCheck_Click" />

                        <TextBlock Text="SESSION" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="ElapsedText" Text="Durée : 00:00" />
                        <TextBlock x:Name="RemainingText" Text="Restant : —" />
                        <TextBlock x:Name="FpsText" Text="Images par seconde : —" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Images/s visées :" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TargetFpsBox" Text="5" Width="40" LostFocus="TargetFpsBox_LostFocus" />
                        </StackPanel>

                        <TextBlock Text="JEU" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="GameWindowText" Text="Fenêtre du jeu : non cherchée" TextWrapping="Wrap" />

                        <TextBlock Text="SÉCURITÉ" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="EmergencyKeyCheck" Content="Touche d'arrêt d'urgence (Num 5)" IsChecked="True"
                                  Click="SafetyCheck_Click" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="MaxDurationCheck" Content="Durée max (min) :" IsChecked="True"
                                      Click="SafetyCheck_Click" VerticalAlignment="Center" />
                            <TextBox x:Name="MaxDurationBox" Text="15" Width="40" Margin="6,0,0,0"
                                     LostFocus="MaxDurationBox_LostFocus" />
                        </StackPanel>
                        <CheckBox x:Name="AnomalyCheck" Content="Arrêt sur anomalie (RAM du bot critique)" IsChecked="True"
                                  Click="SafetyCheck_Click" />
                        <CheckBox Content="Arrêt si la souris bouge (à partir de v0.4)" IsEnabled="False" />

                        <TextBlock x:Name="VersionText" Text="Version" Foreground="#9AA0A6" Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Dernier événement du journal (le journal complet est dans l’onglet Paramètres) -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#141517" BorderBrush="#3C3F44" BorderThickness="1"
                        Margin="0,6,0,0" Padding="8,4">
                    <DockPanel>
                        <TextBlock x:Name="AlertCounters" DockPanel.Dock="Right" Foreground="#9AA0A6" Margin="12,0,0,0" />
                        <TextBlock x:Name="LastEventText" Text="—" FontFamily="Consolas" FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- ONGLET : PERSONNAGE (lecture du serveur, D-039) : en direct, bonus actifs, sac et banques -->
        <TabItem Header="Personnage">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#9AA0A6" Margin="0,0,0,10" MaxWidth="1100" HorizontalAlignment="Left"
                               Text="Ce que le serveur dit de votre personnage, en direct. Connexion : onglet « Paramètres »." />
                    <WrapPanel>
                        <!-- 3. En direct -->
                        <Border Style="{StaticResource Card}" Width="360">
                            <StackPanel>
                                <TextBlock Text="1. PERSONNAGE EN DIRECT" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Personnage" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SrvCharacter" Text="—" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="1" Text="Région" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SrvRegion" Text="—" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="2" Text="Position serveur" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SrvPosition" Text="—" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="3" Text="Destination" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SrvDestination" Text="—" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="4" Text="Position écran" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SrvHudPosition" Text="— (lancer « Démarrer » dans l’onglet Bot)" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="5" Text="Vie" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SrvHealth" Text="—" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="6" Text="Endurance" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="SrvStamina" Text="—" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="7" Text="Faim (satiété)" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="SrvSatiation" Text="—" Style="{StaticResource HudValue}" />
                                    <TextBlock Grid.Row="8" Text="Mise à jour" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" x:Name="SrvUpdated" Text="—" Style="{StaticResource HudValue}" />
                                </Grid>
                                <Button x:Name="ServerSnapshotButton" Content="Enregistrer un instantané (diagnostic)" HorizontalAlignment="Left"
                                        Margin="0,8,0,0" IsEnabled="False" Click="ServerSnapshotButton_Click" />
                            </StackPanel>
                        </Border>

                    <!-- Bonus actifs (active_buff_state, lecture seule) -->
                    <Border Style="{StaticResource Card}" Width="920">
                        <StackPanel>
                            <TextBlock Text="2. BONUS ACTIFS" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                            <TextBlock x:Name="BuffSummary" Text="Pas connecté." Foreground="#9AA0A6" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ListView x:Name="BuffList" MaxHeight="260" Background="#141517" Foreground="#E6E6E6" BorderBrush="#3C3F44">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Bonus" Width="230" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Type" Width="130" DisplayMemberBinding="{Binding Type}" />
                                        <GridViewColumn Header="Reste" Width="90" DisplayMemberBinding="{Binding Remaining}" />
                                        <GridViewColumn Header="Effets" Width="420" DisplayMemberBinding="{Binding Effects}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>
                    </WrapPanel>

                    <!-- 4. Sac et banques (inventory_state, lecture seule) -->
                    <Border Style="{StaticResource Card}" HorizontalAlignment="Left" MinWidth="760">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="3. SAC ET BANQUES" Style="{StaticResource SectionTitle}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <TextBlock Text="Afficher :" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="InventoryPicker" Width="320" SelectionChanged="InventoryPicker_SelectionChanged" />
                                <TextBlock Text="Chercher :" VerticalAlignment="Center" Margin="16,0,6,0" />
                                <TextBox x:Name="InventorySearchBox" Width="180" TextChanged="InventorySearchBox_TextChanged" />
                            </StackPanel>
                            <TextBlock x:Name="InventorySummary" Text="Pas connecté." Foreground="#9AA0A6" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ListView x:Name="InventoryList" Height="380" Background="#141517" Foreground="#E6E6E6" BorderBrush="#3C3F44">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Objet" Width="250" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Quantité" Width="80" DisplayMemberBinding="{Binding Quantity}" />
                                        <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding Kind}" />
                                        <GridViewColumn Header="Palier" Width="50" DisplayMemberBinding="{Binding Tier}" />
                                        <GridViewColumn Header="Où" Width="260" DisplayMemberBinding="{Binding Where}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Text="Lu sur le serveur, en lecture seule : votre sac, votre ceinture d'outils et vos coffres de banque dans la région où vous êtes. Une banque n'apparaît qu'après l'avoir ouverte au moins une fois dans le jeu."
                                       Foreground="#9AA0A6" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ONGLET : CARTE (ressources lues sur le serveur, H2) -->
        <TabItem Header="Carte">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6">
                <StackPanel>
                    <!-- Bandeau : personnage et filtres -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="MapPlayerText" Text="Pas connecté : connectez-vous dans l'onglet « Paramètres »." FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                <TextBlock Text="AFFICHER" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Content="Tout" Click="FamilyAll_Click" Padding="8,1" Margin="0,0,6,0" />
                                <Button Content="Arbres seulement" Click="FamilyTrees_Click" Padding="8,1" Margin="0,0,16,0" />
                                <TextBlock x:Name="SrvResourceCount" Text="" Foreground="#9AA0A6" VerticalAlignment="Center" />
                            </StackPanel>
                            <WrapPanel x:Name="FamilyChecks" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Carte + légende -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <local:ResourceMap x:Name="SrvMap" Width="560" Height="560" Cursor="Hand" />
                                <WrapPanel Margin="0,6,0,0" MaxWidth="560">
                                    <TextBlock Margin="0,0,12,2"><Run Text="●" Foreground="#8AB4F8" /> vous</TextBlock>
                                    <TextBlock Margin="0,0,12,2"><Run Text="●" Foreground="#34A853" FontSize="16" /> arbre mûr</TextBlock>
                                    <TextBlock Margin="0,0,12,2"><Run Text="●" Foreground="#A8DAB5" /> jeune</TextBlock>
                                    <TextBlock Margin="0,0,12,2"><Run Text="●" Foreground="#8D6E63" /> mort</TextBlock>
                                    <TextBlock Margin="0,0,12,2"><Run Text="○" Foreground="#FB8C00" /> entamé</TextBlock>
                                    <TextBlock Margin="0,0,12,2"><Run Text="◯" Foreground="#FDD663" /> meilleur arbre</TextBlock>
                                    <TextBlock Margin="0,0,12,2"><Run Text="◯" Foreground="#F28BF5" /> cible à l'écran</TextBlock>
                                    <TextBlock Margin="0,0,12,2"><Run Text="◯" Foreground="White" /> sélection</TextBlock>
                                </WrapPanel>
                                <TextBlock Text="Autres ressources : la couleur de leur case à cocher. Nord en haut, est à droite. Cercles : 5 et 10 cases du jeu. Cliquez un point pour le retrouver dans le tableau."
                                           Foreground="#9AA0A6" TextWrapping="Wrap" MaxWidth="560" Margin="0,4,0,0" />
                            </StackPanel>
                            <!-- Résumé + tableau -->
                            <StackPanel Grid.Column="1" MinWidth="640">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Meilleur arbre" Style="{StaticResource HudLabel}" Foreground="#FDD663" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SrvBestTree" Text="—" Style="{StaticResource HudValue}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Text="Cible à l'écran" Style="{StaticResource HudLabel}" Foreground="#F28BF5" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SrvScreenTarget" Text="—" Style="{StaticResource HudValue}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="Zone lue" Style="{StaticResource HudLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SrvArea" Text="—" Style="{StaticResource HudValue}" TextWrapping="Wrap" />
                                </Grid>
                                <ListView x:Name="SrvResourceList" Height="480" Background="#141517" Foreground="#E6E6E6" BorderBrush="#3C3F44"
                                          SelectionChanged="SrvResourceList_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="" Width="34" DisplayMemberBinding="{Binding Mark}" />
                                            <GridViewColumn Header="Nom" Width="190" DisplayMemberBinding="{Binding Name}" />
                                            <GridViewColumn Header="Famille" Width="130" DisplayMemberBinding="{Binding Kind}" />
                                            <GridViewColumn Header="Âge" Width="70" DisplayMemberBinding="{Binding Age}" />
                                            <GridViewColumn Header="Santé" Width="150" DisplayMemberBinding="{Binding Health}" />
                                            <GridViewColumn Header="Distance" Width="65" DisplayMemberBinding="{Binding Distance}" />
                                            <GridViewColumn Header="Direction" Width="65" DisplayMemberBinding="{Binding Direction}" />
                                            <GridViewColumn Header="Position (±1)" Width="120" DisplayMemberBinding="{Binding Position}" />
                                            <GridViewColumn Header="Palier" Width="45" DisplayMemberBinding="{Binding Tier}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock Text="Distance en cases du jeu (mêmes unités que N / E). Position : à 1 case près (le serveur arrondit un peu la position quand on s'arrête). « Meilleur arbre » : l'arbre mûr le plus proche, celui que le bot visera en H3. « Cible à l'écran » : la ressource que vous ciblez dans le jeu, retrouvée par son nom et sa santé (il faut lancer « Démarrer » dans l’onglet Bot pour lire l’écran)."
                                           Foreground="#9AA0A6" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="900" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ONGLET : RECETTES (données du jeu BitCraft_GameData, D-033) -->
        <TabItem Header="Recettes">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CHERCHER UN OBJET" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox x:Name="RecipeSearchBox" Width="420" FontSize="15" TextChanged="RecipeSearchBox_TextChanged" />
                            <TextBlock x:Name="RecipeSearchInfo" Text="" Foreground="#9AA0A6" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Tapez une partie du nom en anglais (ex. « plank », « oak », « ingot »). Les données viennent de BitCraft_GameData (mises à jour chaque jour)."
                                   Foreground="#9AA0A6" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="RecipeResults" Background="#141517" Foreground="#E6E6E6" BorderBrush="#3C3F44"
                             SelectionChanged="RecipeResults_SelectionChanged" />
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                        <StackPanel x:Name="RecipeDetails" Margin="4,0,0,0">
                            <TextBlock Text="Choisissez un objet dans la liste." Foreground="#9AA0A6" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ONGLET : PARAMÈTRES : réglages à gauche, journal à droite (v0.3.16) -->
        <TabItem Header="Paramètres">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <TextBlock Text="CONNEXION AU SERVEUR (LECTURE SEULE)" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="#9AA0A6" Margin="0,0,0,6" MaxWidth="1100" HorizontalAlignment="Left"
                               Text="Lecture en direct du serveur officiel, avec le jeton de votre compte. Le bot ne fait que lire : aucune action n'est envoyée au serveur. Le jeton est chiffré par Windows sur ce PC, et n'apparaît jamais dans le journal." />
                    <WrapPanel>
                        <!-- 1. Compte -->
                        <Border Style="{StaticResource Card}" Width="360">
                            <StackPanel>
                                <TextBlock Text="1. COMPTE BITCRAFT" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <TextBlock Text="Adresse e-mail liée au compte BitCraft :" />
                                <TextBox x:Name="ServerEmailBox" Margin="0,2,0,6" />
                                <Button x:Name="RequestCodeButton" Content="Recevoir le code par e-mail" HorizontalAlignment="Left"
                                        Click="RequestCodeButton_Click" />
                                <TextBlock Text="Code reçu :" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBox x:Name="ServerCodeBox" Width="140" Margin="0,0,6,0" />
                                    <Button x:Name="ValidateCodeButton" Content="Valider le code" Click="ValidateCodeButton_Click" />
                                </StackPanel>
                                <TextBlock x:Name="TokenStatusText" Text="Aucun jeton enregistré." Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <Button x:Name="ForgetTokenButton" Content="Oublier le jeton" HorizontalAlignment="Left" Margin="0,6,0,0"
                                        Click="ForgetTokenButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- 2. Connexion -->
                        <Border Style="{StaticResource Card}" Width="360">
                            <StackPanel>
                                <TextBlock Text="2. CONNEXION" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Région : R" VerticalAlignment="Center" />
                                    <TextBox x:Name="ServerRegionBox" Text="18" Width="40" Margin="2,0,0,0" />
                                </StackPanel>
                                <Border Background="#3A2E12" CornerRadius="4" Padding="8" Margin="0,8,0,8">
                                    <TextBlock TextWrapping="Wrap" Foreground="#FDD663"
                                               Text="Ordre à respecter : 1) jeu fermé, 2) connecter le bot ici, 3) lancer le jeu. Si le jeu est déjà lancé, le bot refuse de se connecter : il éjecterait le jeu (« Logged in elsewhere »). Une fois le jeu lancé, déconnecter le bot ne touche pas le jeu." />
                                </Border>
                                <TextBlock x:Name="ServerGameRunningText" Text="Jeu : —" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="ServerConnectButton" Content="Se connecter" Click="ServerConnectButton_Click" />
                                    <Button x:Name="ServerDisconnectButton" Content="Se déconnecter" IsEnabled="False" Click="ServerDisconnectButton_Click" />
                                </StackPanel>
                                <TextBlock x:Name="ServerStateText" Text="Pas connecté." Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock x:Name="ServerTrafficText" Text="" Foreground="#9AA0A6" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Affichage sur l'écran du jeu -->
                        <Border Style="{StaticResource Card}" Width="360">
                            <StackPanel>
                                <TextBlock Text="3. AFFICHAGE SUR L'ÉCRAN DU JEU" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <CheckBox x:Name="OverlayCheck" Content="Afficher l'overlay (état du bot et touches)" IsChecked="True" Click="OverlayCheck_Click" />
                                <TextBlock TextWrapping="Wrap" Foreground="#9AA0A6" Margin="0,6,0,0"
                                           Text="Petit cadre en haut à gauche de l'écran du jeu : bot connecté ou non, lecture de l'écran, rappel des touches Num 0 (capture) et Num 5 (arrêt). Il laisse passer les clics et n'apparaît pas dans les captures du bot." />
                            </StackPanel>
                        </Border>
                    </WrapPanel>


                    <TextBlock Text="SYSTÈME" Style="{StaticResource SectionTitle}" Margin="0,10,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="#9AA0A6" Margin="0,0,0,10"
                               Text="Consommation mesurée chaque seconde. Le bot ne fait que lire ces valeurs : il ne modifie ni le jeu ni Windows. Si sa RAM dépasse le seuil critique, la session s'arrête toute seule." />
                    <WrapPanel>
                        <Border Style="{StaticResource Card}" Width="320">
                            <StackPanel>
                                <TextBlock Text="LE BOT" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <TextBlock x:Name="BotCpuText" Text="CPU : —" />
                                <Canvas x:Name="BotCpuGraph" Height="50" Margin="0,4" Background="#1A1C1F" ClipToBounds="True" />
                                <TextBlock x:Name="BotRamText" Text="RAM : —" />
                                <Canvas x:Name="BotRamGraph" Height="50" Margin="0,4" Background="#1A1C1F" ClipToBounds="True" />
                                <TextBlock x:Name="BotDetailsText" Text="—" Foreground="#9AA0A6" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="320">
                            <StackPanel>
                                <TextBlock Text="LE JEU (BitCraft)" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <TextBlock x:Name="GameCpuText" Text="CPU : —" />
                                <TextBlock x:Name="GameRamText" Text="RAM : —" />
                                <TextBlock Text="LE PC" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="SystemCpuText" Text="CPU : —" />
                                <TextBlock x:Name="SystemRamText" Text="RAM libre : —" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="320">
                            <StackPanel>
                                <TextBlock Text="SEUILS" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="RAM du bot : alerte (Mo)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="RamWarningBox" Margin="0,2" LostFocus="LimitBox_LostFocus" />
                                    <TextBlock Grid.Row="1" Text="RAM du bot : arrêt (Mo)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="RamCriticalBox" Margin="0,2" LostFocus="LimitBox_LostFocus" />
                                    <TextBlock Grid.Row="2" Text="CPU du bot : alerte (%)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="CpuWarningBox" Margin="0,2" LostFocus="LimitBox_LostFocus" />
                                    <TextBlock Grid.Row="3" Text="RAM libre du PC : alerte (%)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="SystemRamWarningBox" Margin="0,2" LostFocus="LimitBox_LostFocus" />
                                </Grid>
                                <TextBlock x:Name="ResourceStateText" Text="État : normal" Margin="0,8,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
                </ScrollViewer>

                <!-- Journal (ancien onglet Journal) -->
                <Border Grid.Column="1" Margin="8,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="JOURNAL" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Afficher :" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <CheckBox x:Name="FilterErreur" Content="Erreurs" IsChecked="True" Margin="0,0,12,0" Click="LogFilter_Click" Foreground="#F28B82" />
                        <CheckBox x:Name="FilterAlerte" Content="Alertes" IsChecked="True" Margin="0,0,12,0" Click="LogFilter_Click" Foreground="#FDD663" />
                        <CheckBox x:Name="FilterInfo" Content="Infos" IsChecked="True" Margin="0,0,12,0" Click="LogFilter_Click" />
                        <CheckBox x:Name="FilterDetail" Content="Détails" IsChecked="True" Margin="0,0,20,0" Click="LogFilter_Click" Foreground="#9AA0A6" />
                        <Button Content="Ouvrir le dossier des journaux" Click="OpenLogFolder_Click" />
                        <TextBlock x:Name="LogFileText" VerticalAlignment="Center" Foreground="#9AA0A6" Margin="8,0,0,0" />
                    </StackPanel>
                    <ListBox x:Name="LogList" Background="#141517" BorderBrush="#3C3F44" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
