<Window x:Class="BitcraftBot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BitcraftBot.App"
        Title="BitCraft Bot"
        Icon="Assets/bitcraftbot.ico"
        Width="960" Height="540" MinWidth="640" MinHeight="420"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="CanResize">
    <!-- Thème BitCraft (v0.3.18) : Themes/BitCraft.xaml. Peu de texte : l'essentiel seulement (demande de Julien). -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/BitCraft.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Background>
        <StaticResource ResourceKey="Bg" />
    </Window.Background>
    <Window.Foreground>
        <StaticResource ResourceKey="Text" />
    </Window.Foreground>

    <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChangedForChat">

        <!-- BOT : tableau de bord, image du jeu, commandes -->
        <TabItem x:Name="BotTabItem" Header="BOT">
            <ScrollViewer x:Name="BotScroll" VerticalScrollBarVisibility="Disabled">
            <Grid x:Name="BotGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="BotSideColumn" Width="300" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="BotMain">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="200" />
                    </Grid.RowDefinitions>
                    <UniformGrid x:Name="DashboardGrid" Columns="4">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="PERSONNAGE" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="DashHealthText" Text="Vie —" />
                                <ProgressBar x:Name="DashHealthBar" Foreground="{StaticResource HealthBar}" />
                                <TextBlock x:Name="DashStaminaText" Text="Endurance —" />
                                <ProgressBar x:Name="DashStaminaBar" Foreground="{StaticResource StaminaBar}" />
                                <TextBlock x:Name="DashHungerText" Text="Faim —" />
                                <ProgressBar x:Name="DashHungerBar" Foreground="{StaticResource HungerBar}" />
                                <TextBlock x:Name="DashBonusText" Text="Bonus —" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="ACTIVITÉ" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="DashActionText" Text="Action —" />
                                <ProgressBar x:Name="DashActionBar" Foreground="{StaticResource ActionBar}" />
                                <TextBlock x:Name="DashSkillText" Text="Métier —" />
                                <ProgressBar x:Name="DashSkillBar" Foreground="{StaticResource SkillBar}" />
                                <TextBlock x:Name="DashHitText" Text="Cible —" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="SAC ET ALENTOURS" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="DashSacText" Text="Sac —" />
                                <ProgressBar x:Name="DashSacBar" Foreground="{StaticResource BagBar}" />
                                <TextBlock x:Name="DashPositionText" Text="Position —" />
                                <TextBlock x:Name="DashBestTreeText" Text="Arbre —" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Image du jeu en direct, zones lues en surimpression -->
            <Border x:Name="BotBuffs" Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="BONUS ACTIFS" Style="{StaticResource CardTitle}" />
                    <TextBlock DockPanel.Dock="Top" Visibility="Collapsed" x:Name="BuffSummary" Text="—" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                    <WrapPanel x:Name="BuffPanel" />
                </DockPanel>
            </Border>

                    <Border x:Name="GameImageCard" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{StaticResource Track}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="6" Margin="6">
                        <Grid>
                            <Viewbox Stretch="Uniform" Margin="2">
                                <Grid x:Name="FrameHost">
                                    <Image x:Name="GameImage" Stretch="Fill" RenderOptions.BitmapScalingMode="LowQuality" />
                                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="NoImageText" Text="Image du jeu : « Démarrer »" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Commandes -->
                <ScrollViewer x:Name="BotSide" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="StatusBorder" Style="{StaticResource Card}" Background="#1F2F45">
                            <StackPanel>
                                <TextBlock x:Name="StatusText" Text="ARRÊTÉ" FontSize="20" FontWeight="Bold" />
                                <TextBlock x:Name="StatusDetail" Text="" Style="{StaticResource MutedText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="StartButton" Content="DÉMARRER" Style="{StaticResource PrimaryButton}" Click="StartButton_Click" />
                                    <Button x:Name="StopButton" Content="ARRÊTER" Style="{StaticResource DangerButton}" Click="StopButton_Click" IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="OPTIONS" Style="{StaticResource CardTitle}" />
                                <CheckBox x:Name="AutoEatCheck" Style="{StaticResource SwitchCheck}" Content="Repas auto (Maj + E)" Click="AutoEatCheck_Click" />
                                <TextBlock x:Name="AutoEatStatusText" Visibility="Collapsed" Text="" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="AutoEatFoodText" Visibility="Collapsed" Text="" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,12" />
                                <CheckBox x:Name="GptCheck" Style="{StaticResource SwitchCheck}" Content="Chat @gpt / @chatgpt" ToolTip="Répondre à « @gpt » et « @chatgpt » (Local, Région, LFG, Trade)" Click="GptCheck_Click" />
                                <TextBlock x:Name="GptStatusText" Visibility="Collapsed" Text="" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="GptTimerText" Visibility="Collapsed" Text="" Margin="0,2,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                                <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,12" />
                                <CheckBox x:Name="ResumeCheck" Style="{StaticResource SwitchCheck}" Content="Reprise des récoltes" ToolTip="Quand une récolte s'arrête faute d'endurance : attend l'endurance, resélectionne la ressource (Tab) et relance (M), sans bouger" Click="ResumeCheck_Click" />
                                <TextBlock x:Name="ResumeStatusText" Text="" Style="{StaticResource MutedText}" Margin="0,4,0,8" TextWrapping="Wrap" />
                                <CheckBox x:Name="AbilitiesCheck" Style="{StaticResource SwitchCheck}" Content="Capacités auto" ToolTip="Pendant que vous récoltez : lance la capacité de la barre d'action qui va avec (endurance gardée au-dessus de 30 %)" Click="AbilitiesCheck_Click" />
                                <TextBlock x:Name="AbilitiesStatusText" Text="" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <StackPanel x:Name="AbilityList" Margin="16,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="ÉCRAN" Style="{StaticResource CardTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Je vois" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SeenText" Text="—" Style="{StaticResource Value}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Text="Caméra" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HeadingText" Text="—" Style="{StaticResource Value}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="Fenêtres" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="WindowsText" Text="—" Style="{StaticResource Value}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" Text="Cible" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="HudTarget" Text="—" Style="{StaticResource Value}" />
                                    <TextBlock Grid.Row="4" Text="Santé" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="HudTargetHealth" Text="—" Style="{StaticResource Value}" />
                                    <TextBlock Grid.Row="5" Text="Durée" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ElapsedText" Text="—" Style="{StaticResource Value}" />
                                    <TextBlock Grid.Row="6" Text="Images/s" Style="{StaticResource Label}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="FpsText" Text="—" Style="{StaticResource Value}" />
                                </Grid>
                            </StackPanel>
                        </Border>


                        <!-- Éléments retirés de l'écran (v0.4.13) mais toujours remplis par le code : cachés. -->
                        <StackPanel x:Name="Parking" Visibility="Collapsed">
                <Border x:Name="PersoLive" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="EN DIRECT" Style="{StaticResource CardTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Personnage" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SrvCharacter" Text="—" Style="{StaticResource Value}" />
                            <TextBlock Grid.Row="1" Text="Région" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SrvRegion" Text="—" Style="{StaticResource Value}" />
                            <TextBlock Grid.Row="2" Text="Position" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SrvPosition" Text="—" Style="{StaticResource Value}" />
                            <TextBlock Grid.Row="3" Text="Destination" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SrvDestination" Text="—" Style="{StaticResource Value}" />
                            <TextBlock Grid.Row="4" Text="Vie" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SrvHealth" Text="—" Style="{StaticResource Value}" />
                            <TextBlock Grid.Row="5" Text="Endurance" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SrvStamina" Text="—" Style="{StaticResource Value}" />
                            <TextBlock Grid.Row="6" Text="Faim" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="SrvSatiation" Text="—" Style="{StaticResource Value}" />
                            <TextBlock Grid.Row="7" Text="Mise à jour" Style="{StaticResource Label}" />
                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="SrvUpdated" Text="—" Style="{StaticResource Value}" />
                        </Grid>
                        <Button x:Name="ServerSnapshotButton" Content="Instantané" Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" IsEnabled="False" Click="ServerSnapshotButton_Click" />
                    </StackPanel>
                </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="LE BOT" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="DashServerText" Text="○ Serveur" Margin="0,0,0,4" />
                                <TextBlock x:Name="DashScreenText" Text="○ Écran" Margin="0,0,0,4" />
                                <TextBlock x:Name="DashMealText" Text="○ Repas auto" Margin="0,0,0,4" />
                                <TextBlock x:Name="GameWindowText" Text="○ Jeu" Margin="0,0,0,4" />
                                <TextBlock x:Name="DashAlertText" Text="" Foreground="{StaticResource Warn}" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="SPRINT ET BARRE D'ACTION" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="SprintText" Text="Sprint : —" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="ActionBarText" Text="—" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="SACS AU SOL" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="GroundText" Text="—" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Dernier événement du journal -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="4" Margin="6,4,6,0" Padding="10,5">
                    <DockPanel>
                        <TextBlock x:Name="AlertCounters" DockPanel.Dock="Right" Style="{StaticResource MutedText}" Margin="12,0,0,0" TextWrapping="NoWrap" />
                        <TextBlock x:Name="LastEventText" Text="—" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
            </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- CHAT : archive du chat en local (v0.4.16) ; chatbot @gpt (historique, statistiques, test) en dessous, replié -->
        <TabItem x:Name="ChatTabItem" Header="CHAT">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="ARCHIVE DU CHAT" Style="{StaticResource CardTitle}" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <TextBlock Text="Joueur" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="ChatArchivePlayerBox" Width="200" TextChanged="ChatArchiveFilter_Changed" ToolTip="Chercher un joueur (une partie du nom suffit)" Margin="0,0,16,0" />
                        <ComboBox x:Name="ChatArchiveChannelBox" Width="170" SelectionChanged="ChatArchiveFilter_Changed" ToolTip="Filtrer par canal" Margin="0,0,16,0" />
                        <TextBlock x:Name="ChatArchiveCount" Text="Archive en cours d'ouverture…" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </WrapPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <ListView x:Name="ChatArchiveList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="ToolTip" Value="{Binding Tip}" />
                                <Style.Triggers>
                                    <!-- v0.4.20 : nouveau message, fond doré quelques secondes -->
                                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                                        <Setter Property="Background" Value="#40D2B65D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Heure" Width="110" DisplayMemberBinding="{Binding Time}" />
                                <GridViewColumn Header="Canal" Width="120" DisplayMemberBinding="{Binding Channel}" />
                                <GridViewColumn Header="Joueur" Width="150" DisplayMemberBinding="{Binding Player}" />
                                <GridViewColumn Header="Texte" Width="700" DisplayMemberBinding="{Binding Text}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="ChatBotToggle" DockPanel.Dock="Right" Content="Afficher le chatbot @gpt" Style="{StaticResource SmallButton}" Click="ChatBotToggle_Click" />
                            <TextBlock x:Name="ChatTabStatus" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel x:Name="ChatBotPanel" Visibility="Collapsed">
                            <TextBlock x:Name="ChatTabStats" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox x:Name="ChatTestBox" Width="420" VerticalContentAlignment="Center" ToolTip="Écris un message de joueur, par exemple : @gpt salut, tu coupes des arbres ?" />
                                <Button x:Name="ChatTestButton" Content="Tester une phrase (rien n'est envoyé)" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="ChatTestButton_Click" />
                            </StackPanel>
                            <TextBlock x:Name="ChatTestResult" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBox x:Name="ChatHistoryBox" Height="160" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- PERSONNAGE : en direct, bonus, sac et banques (serveur) -->
        <TabItem x:Name="CharacterTabItem" Header="PERSONNAGE">
            <Grid x:Name="PersoGrid">
                <Grid.Resources>
                    <!-- v0.4.15 : image de l'objet à gauche de son nom. -->
                    <DataTemplate x:Key="ItemNameCell">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="38" Height="38" Margin="0,1,8,1" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </DataTemplate>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <Border x:Name="PersoFilter" Style="{StaticResource Card}">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="SAC, CEINTURE ET BANQUES" Style="{StaticResource CardTitle}" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <TextBox x:Name="InventorySearchBox" Width="260" TextChanged="InventorySearchBox_TextChanged" ToolTip="Chercher un objet dans les trois listes" Margin="0,0,16,0" />
                        <TextBlock x:Name="InventorySummary" Text="" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    </WrapPanel>
                </Border>

                <!-- v0.4.24 (Julien) : ceinture en bandeau sur toute la largeur, peu haute ; sac et banques dessous, la banque plus large. -->
                <Grid x:Name="PersoBag" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Image x:Name="BagLogo" Width="40" Height="40" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="BagTitle" Text="SAC" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ListView x:Name="BagList" MinHeight="150" GridViewColumnHeader.Click="InventoryHeader_Click">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Objet" Width="190" CellTemplate="{StaticResource ItemNameCell}" />
                                        <GridViewColumn Header="Quantité" Width="92" DisplayMemberBinding="{Binding Quantity, StringFormat=N0}" />
                                        <GridViewColumn Header="Type" Width="92" DisplayMemberBinding="{Binding Kind}" />
                                        <GridViewColumn Header="Tier" Width="70" DisplayMemberBinding="{Binding TierText}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Vertical" Margin="0,0,12,0" Width="120">
                                <Image x:Name="BeltLogo" Width="40" Height="40" Margin="0,0,0,6" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="BeltTitle" Text="CEINTURE D'OUTILS" Style="{StaticResource CardTitle}" Margin="0" TextWrapping="Wrap" />
                            </StackPanel>
                            <!-- v0.4.22 : ceinture en vignettes (image, tier en bas à droite, nom dessous), pas en tableau -->
                            <ListView x:Name="BeltList" MaxHeight="200" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                        <Setter Property="Padding" Value="4" />
                                        <Setter Property="Margin" Value="2" />
                                        <!-- v0.4.23 : le modèle du thème dessine une ligne de tableau (rien sans colonnes) : vignette à la place. -->
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="B" Property="Background" Value="#1A3657" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="B" Property="Background" Value="{StaticResource Blue}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="ToolTip">
                                            <Setter.Value>
                                                <TextBlock>
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><LineBreak />
                                                    <Run Text="Tier" /> <Run Text="{Binding TierText, Mode=OneWay}" /><Run Text=" · quantité" /> <Run Text="{Binding Quantity, Mode=OneWay, StringFormat=N0}" />
                                                </TextBlock>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="84">
                                            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                                <Image Source="{Binding Icon}" Width="60" Height="60" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#E0101824" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="4" Padding="4,0">
                                                    <TextBlock Foreground="{StaticResource Gold}" FontSize="11" FontWeight="Bold">
                                                        <Run Text="T" /><Run Text="{Binding TierText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Image x:Name="BankLogo" Width="40" Height="40" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="BankTitle" Text="BANQUES" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ListView x:Name="BankList" MinHeight="150" GridViewColumnHeader.Click="InventoryHeader_Click">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Objet" Width="190" CellTemplate="{StaticResource ItemNameCell}" />
                                        <GridViewColumn Header="Quantité" Width="92" DisplayMemberBinding="{Binding Quantity, StringFormat=N0}" />
                                        <GridViewColumn Header="Type" Width="92" DisplayMemberBinding="{Binding Kind}" />
                                        <GridViewColumn Header="Tier" Width="70" DisplayMemberBinding="{Binding TierText}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <!-- VOYAGEURS : tâches de voyageur comparées au stock (serveur, v0.4.11) -->
        <TabItem x:Name="TravelerTabItem" Header="VOYAGEURS">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <UniformGrid Columns="4">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="À RENDRE MAINTENANT" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="TravelerNowCount" Text="—" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Good}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="À ALLER CHERCHER" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="TravelerFetchCount" Text="—" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="PARTIELLES" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="TravelerPartialCount" Text="—" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Warn}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="À FARMER" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="TravelerImpossibleCount" Text="—" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Bad}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="TravelerSummary" Text="Serveur pas encore lu." Style="{StaticResource MutedText}" Margin="12,0,12,0" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TravelerPanel" Margin="0,0,0,12" />
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- CARTE : ressources autour (serveur) -->
        <TabItem x:Name="MapTabItem" Header="CARTE">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            </StackPanel>
                            <TextBlock x:Name="MapPlayerText" Text="Pas connecté." FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="Ressources" Width="80" Style="{StaticResource Label}" Foreground="{StaticResource Gold}" DockPanel.Dock="Left" />
                            <WrapPanel x:Name="FamilyChecks" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock Text="Tier" Width="80" Style="{StaticResource Label}" Foreground="{StaticResource Gold}" DockPanel.Dock="Left"
                                       ToolTip="Clic sur un tier : l'afficher ou le masquer. Clic droit : ce tier seul." />
                            <WrapPanel x:Name="TierChecks" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="SrvResourceCount" Text="" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>

                <Grid x:Name="MapGrid" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="MapCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <!-- v0.4.22 : zoom de la carte -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="−" Width="34" Style="{StaticResource SmallButton}" Click="MapZoomOut_Click" ToolTip="Dézoomer (plus de cases, jusqu'à 100 ; au-delà de la zone lue, la carte gardée en mémoire)" />
                                <Button Content="+" Width="34" Style="{StaticResource SmallButton}" Click="MapZoomIn_Click" ToolTip="Zoomer (moins de cases, jusqu'à 10, plus de détails)" Margin="4,0,8,0" />
                                <TextBlock x:Name="MapZoomText" Text="vue : 30 cases" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Viewbox x:Name="MapBox" MaxWidth="560" MaxHeight="560" Stretch="Uniform">
                                <local:ResourceMap x:Name="SrvMap" Width="560" Height="560" Cursor="Hand" />
                            </Viewbox>
                            <WrapPanel Margin="0,8,0,0" MaxWidth="560">
                                <WrapPanel.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Margin" Value="0,0,12,2" />
                                    </Style>
                                </WrapPanel.Resources>
                                <TextBlock><Run Text="●" Foreground="#5FA8E0" /> vous</TextBlock>
                                <TextBlock><Run Text="●" Foreground="#34A853" FontSize="16" /> mûr</TextBlock>
                                <TextBlock><Run Text="●" Foreground="#A8DAB5" /> jeune</TextBlock>
                                <TextBlock><Run Text="●" Foreground="#8D6E63" /> mort</TextBlock>
                                <TextBlock><Run Text="○" Foreground="#FB8C00" /> entamé</TextBlock>
                                <TextBlock><Run Text="◯" Foreground="#D2B65D" /> recherchée</TextBlock>
                                <TextBlock><Run Text="◯" Foreground="#F28BF5" /> cible</TextBlock>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="MapList" Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <!-- v0.4.23 (Julien) : ressource recherchée, choisie dans la liste en tapant son nom ; la plus proche est entourée d'or. -->
                                <TextBlock Grid.Row="0" Text="Recherchée" Style="{StaticResource Label}" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                                    <Button x:Name="SoughtClear" DockPanel.Dock="Right" Content="×" Width="30" Margin="4,0,0,0" Style="{StaticResource SmallButton}"
                                            Click="SoughtClear_Click" ToolTip="Ne plus rechercher de ressource" />
                                    <Grid>
                                        <TextBox x:Name="SoughtBox" MinWidth="260"
                                                 TextChanged="SoughtBox_TextChanged" PreviewKeyDown="SoughtBox_PreviewKeyDown" GotKeyboardFocus="SoughtBox_GotKeyboardFocus"
                                                 ToolTip="Tapez le nom de la ressource (en anglais, comme dans le jeu), puis choisissez-la dans la liste" />
                                        <Popup x:Name="SoughtPopup" PlacementTarget="{Binding ElementName=SoughtBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="4" MinWidth="260">
                                                <ListBox x:Name="SoughtList" MaxHeight="260" Background="Transparent" BorderThickness="0"
                                                         PreviewMouseLeftButtonUp="SoughtList_PreviewMouseLeftButtonUp" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Text="Plus proche" Style="{StaticResource Label}" Foreground="{StaticResource Gold}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SrvBestTree" Text="—" Style="{StaticResource Value}" />
                                <TextBlock Grid.Row="2" Text="Cible écran" Style="{StaticResource Label}" Foreground="#F28BF5" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SrvScreenTarget" Text="—" Style="{StaticResource Value}" />
                                <TextBlock Grid.Row="3" Text="Zone lue" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SrvArea" Text="—" Style="{StaticResource Value}" />
                            </Grid>
                            <ListView x:Name="SrvResourceList" MinHeight="200" SelectionChanged="SrvResourceList_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="" Width="34" DisplayMemberBinding="{Binding Mark}" />
                                        <GridViewColumn Header="Nom" Width="190" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Famille" Width="120" DisplayMemberBinding="{Binding Kind}" />
                                        <GridViewColumn Header="Âge" Width="70" DisplayMemberBinding="{Binding Age}" />
                                        <GridViewColumn Header="Santé" Width="140" DisplayMemberBinding="{Binding Health}" />
                                        <GridViewColumn Header="Dist." Width="60" DisplayMemberBinding="{Binding Distance}" />
                                        <GridViewColumn Header="Dir." Width="50" DisplayMemberBinding="{Binding Direction}" />
                                        <GridViewColumn Header="Position" Width="120" DisplayMemberBinding="{Binding Position}" />
                                        <GridViewColumn Header="Tier" Width="55" DisplayMemberBinding="{Binding Tier}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <!-- RECETTES (BitCraft_GameData) -->
        <TabItem Header="RECETTES">
            <Grid x:Name="RecipeGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock Text="CHERCHER" Style="{StaticResource CardTitle}" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="RecipeSearchInfo" DockPanel.Dock="Right" Text="" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="RecipeSearchBox" FontSize="15" Width="420" VerticalContentAlignment="Center"
                                     TextChanged="RecipeSearchBox_TextChanged" KeyDown="RecipeSearchBox_KeyDown"
                                     ToolTip="Nom en anglais : plank, oak, ingot… (Entrée : rechercher, Échap : effacer)" />
                            <Button x:Name="RecipeSearchButton" Content="Rechercher" Margin="8,0,0,0" IsEnabled="False"
                                    Click="RecipeSearchButton_Click" ToolTip="Lancer la recherche (ou touche Entrée)" />
                            <Button x:Name="RecipeClearButton" Content="✕ Effacer" Style="{StaticResource SmallButton}" Margin="8,0,0,0" IsEnabled="False"
                                    Click="RecipeClearButton_Click" ToolTip="Vider le champ de recherche (ou touche Échap)" />
                            <Button x:Name="RecipeBackButton" Content="← Retour" Style="{StaticResource SmallButton}" Margin="8,0,0,0" IsEnabled="False"
                                    Click="RecipeBackButton_Click" ToolTip="Aucune fiche précédente" ToolTipService.ShowOnDisabled="True" />
                            <TextBlock Text="Quantité" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="20,0,6,0" />
                            <TextBox x:Name="RecipeQuantityBox" Text="1" Width="70" VerticalContentAlignment="Center"
                                     TextChanged="RecipeQuantityBox_TextChanged" ToolTip="Combien d'exemplaires de l'objet tu veux : l'arborescence et le plan d'actions s'adaptent" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                    <ListBox x:Name="RecipeResults" BorderThickness="0" Background="Transparent" SelectionChanged="RecipeResults_SelectionChanged" />
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                    <ScrollViewer x:Name="RecipeDetailsScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RecipeDetails">
                            <TextBlock Text="Choisissez un objet." Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </TabItem>

        <!-- PARAMÈTRES : réglages à gauche, journal à droite -->
        <TabItem x:Name="SettingsTabItem" Header="PARAMÈTRES">
            <Grid x:Name="SettingsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- v0.4.14 (demande de Julien) : chaque partie a la taille de son importance.
                     1. Connexion (le plus utilisé), en grand. 2. Caméra (W). 3. Petites cartes : sécurité, affichage, système.
                     4. Compte (e-mail, jeton) replié : il ne change plus. Interrupteurs rouge/vert partout sauf le journal. -->
                <ScrollViewer x:Name="SettingsLeft" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Background="#1F2F45" BorderBrush="{StaticResource GoldDim}">
                            <StackPanel>
                                <TextBlock Text="CONNEXION AU SERVEUR" Style="{StaticResource CardTitle}" Margin="0" />
                                <TextBlock x:Name="ServerStateText" Text="Pas connecté." FontSize="18" FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBlock x:Name="ServerGameRunningText" Text="Jeu —" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="ServerConnectButton" Content="Se connecter" Style="{StaticResource PrimaryButton}" FontSize="15" Padding="24,9" Margin="0,0,10,4" Click="ServerConnectButton_Click" />
                                    <Button x:Name="ServerDisconnectButton" Content="Se déconnecter" FontSize="15" Padding="24,9" IsEnabled="False" Margin="0,0,14,4" Click="ServerDisconnectButton_Click" />
                                    <TextBlock Text="Jeu fermé → Se connecter → lancer le jeu" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,0,4" />
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                                    <TextBlock Text="Région R" Style="{StaticResource Label}" Margin="0,0,4,0" />
                                    <TextBox x:Name="ServerRegionBox" Text="18" Width="48" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="CameraForgetButton" DockPanel.Dock="Right" Content="Oublier les clics" Style="{StaticResource SmallButton}" Margin="0" Click="CameraForgetButton_Click" />
                                    <TextBlock Text="CAMÉRA" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="CameraStateText" Text="Caméra : W pas encore vu" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <WrapPanel Margin="0,2,0,0">
                                    <TextBlock x:Name="CameraCountText" Text="Clics appris : 0" Margin="0,0,16,0" />
                                    <TextBlock x:Name="CameraPrecisionText" Text="Précision : —" />
                                </WrapPanel>
                                <TextBlock x:Name="CameraFormulaText" Text="" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                <TextBlock x:Name="CameraLastText" Text="" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <UniformGrid x:Name="SettingsCards" Columns="3">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="SÉCURITÉ" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox x:Name="MaxDurationCheck" Style="{StaticResource SwitchCheck}" Content="Durée max" IsChecked="True" Click="SafetyCheck_Click" VerticalAlignment="Center" />
                                        <TextBox x:Name="MaxDurationBox" Text="15" Width="44" Margin="8,0,4,0" LostFocus="MaxDurationBox_LostFocus" />
                                        <TextBlock Text="min" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <CheckBox x:Name="AnomalyCheck" Style="{StaticResource SwitchCheck}" Content="Arrêt si RAM critique" IsChecked="True" Click="SafetyCheck_Click" Margin="0,0,0,6" />
                                    <CheckBox x:Name="MouseStopCheck" Style="{StaticResource SwitchCheck}" Content="Arrêt si la souris bouge" IsChecked="True" Click="SafetyCheck_Click" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="AFFICHAGE" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <CheckBox x:Name="OverlayCheck" Style="{StaticResource SwitchCheck}" Content="Overlay sur le jeu" IsChecked="True" Click="OverlayCheck_Click" Margin="0,0,0,6" />
                                    <CheckBox x:Name="ShowZonesCheck" Style="{StaticResource SwitchCheck}" Content="Zones lues sur l'image" IsChecked="True" Click="ShowZonesCheck_Click" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Images/s" Style="{StaticResource Label}" />
                                        <TextBox x:Name="TargetFpsBox" Text="5" Width="44" LostFocus="TargetFpsBox_LostFocus" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="SYSTÈME" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="BotCpuText" Text="CPU —" />
                                    <Canvas x:Name="BotCpuGraph" Height="26" Margin="0,2,0,6" Background="{StaticResource Track}" ClipToBounds="True" />
                                    <TextBlock x:Name="BotRamText" Text="RAM —" />
                                    <Canvas x:Name="BotRamGraph" Height="26" Margin="0,2,0,0" Background="{StaticResource Track}" ClipToBounds="True" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Padding="14,8">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="AccountToggleButton" DockPanel.Dock="Right" Content="Afficher" Style="{StaticResource SmallButton}" Margin="0" Click="AccountToggleButton_Click" />
                                    <TextBlock Text="COMPTE" Style="{StaticResource CardTitle}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TokenStatusText" Text="" FontSize="12" VerticalAlignment="Center" />
                                </DockPanel>
                                <StackPanel x:Name="AccountPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="E-mail" Style="{StaticResource Label}" />
                                    <DockPanel Margin="0,2,0,8">
                                        <Button x:Name="RequestCodeButton" DockPanel.Dock="Right" Content="Recevoir le code" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="RequestCodeButton_Click" />
                                        <TextBox x:Name="ServerEmailBox" />
                                    </DockPanel>
                                    <TextBlock Text="Code" Style="{StaticResource Label}" />
                                    <DockPanel Margin="0,2,0,8">
                                        <Button x:Name="ValidateCodeButton" DockPanel.Dock="Right" Content="Valider" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="ValidateCodeButton_Click" />
                                        <TextBox x:Name="ServerCodeBox" />
                                    </DockPanel>
                                    <Button x:Name="ForgetTokenButton" Content="Oublier le jeton" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Click="ForgetTokenButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Gardés cachés : remplis par le code, inutiles à l'écran (v0.4.13). -->
                        <StackPanel Visibility="Collapsed">
                            <TextBlock x:Name="GameCpuText" Text="Jeu —" />
                            <TextBlock x:Name="SystemCpuText" Text="PC —" />
                            <TextBlock x:Name="ResourceStateText" Text="Normal" />
                            <TextBlock x:Name="VersionText" Text="" />
                            <TextBox x:Name="RamWarningBox" LostFocus="LimitBox_LostFocus" />
                            <TextBox x:Name="RamCriticalBox" LostFocus="LimitBox_LostFocus" />
                            <TextBox x:Name="CpuWarningBox" LostFocus="LimitBox_LostFocus" />
                            <TextBox x:Name="SystemRamWarningBox" LostFocus="LimitBox_LostFocus" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Journal -->
                <Border x:Name="SettingsLog" Grid.Column="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Dossier" Style="{StaticResource SmallButton}" Margin="0" Click="OpenLogFolder_Click" />
                            <WrapPanel>
                                <TextBlock Text="JOURNAL" Style="{StaticResource CardTitle}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="FilterErreur" Content="Erreurs" IsChecked="True" Margin="0,0,12,0" Click="LogFilter_Click" Foreground="{StaticResource Bad}" />
                                <CheckBox x:Name="FilterAlerte" Content="Alertes" IsChecked="True" Margin="0,0,12,0" Click="LogFilter_Click" Foreground="{StaticResource Warn}" />
                                <CheckBox x:Name="FilterInfo" Content="Infos" IsChecked="True" Margin="0,0,12,0" Click="LogFilter_Click" />
                                <CheckBox x:Name="FilterDetail" Content="Détails" IsChecked="True" Margin="0,0,12,0" Click="LogFilter_Click" Foreground="{StaticResource Muted}" />
                            </WrapPanel>
                        </DockPanel>
                        <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="{StaticResource Track}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
